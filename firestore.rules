rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    /* TioVity: solo usuarios autenticados pueden leer y escribir.
     * Colecciones en uso:
     *   ventas        - ventas diarias
     *   gastos        - gastos / sueldos / impuestos / proveedores
     *   presupuestos  - un documento por dispositivo (no se pisan)
     *   config        - catalogo de productos compartido
     */
    match /ventas/{document=**} {
      allow read, write: if request.auth != null;
    }
    match /gastos/{document=**} {
      allow read, write: if request.auth != null;
    }
    match /presupuestos/{document=**} {
      allow read, write: if request.auth != null;
    }
    match /config/{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
